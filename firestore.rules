rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Master Gate helpers for Boards
    function boardExists(boardId) {
      return exists(/databases/$(database)/documents/boards/$(boardId));
    }

    function getBoard(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId));
    }

    function isBoardOwner(boardId) {
      return isSignedIn() && boardExists(boardId) && getBoard(boardId).data.ownerId == request.auth.uid;
    }

    function isBoardOwnerAfter(boardId) {
      return isSignedIn()
        && existsAfter(/databases/$(database)/documents/boards/$(boardId))
        && getAfter(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
    }

    function isBoardMemberDoc(boardId) {
      return isSignedIn() && exists(/databases/$(database)/documents/boards/$(boardId)/members/$(request.auth.uid));
    }

    function getBoardMember(boardId) {
      return get(/databases/$(database)/documents/boards/$(boardId)/members/$(request.auth.uid));
    }

    function isBoardMember(boardId) {
      return isBoardOwner(boardId) || isBoardMemberDoc(boardId);
    }

    function canEditBoard(boardId) {
      return isBoardOwner(boardId) || (
        isBoardMemberDoc(boardId) && getBoardMember(boardId).data.role == 'editor'
      );
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1024
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardRef(data, boardId) {
      return data.keys().hasAll(['boardId', 'ownerId', 'boardTitle', 'role', 'addedAt'])
        && data.keys().hasOnly(['boardId', 'ownerId', 'boardTitle', 'role', 'addedAt'])
        && isValidId(data.boardId)
        && data.boardId == boardId
        && isValidId(data.ownerId)
        && data.boardTitle is string && data.boardTitle.size() >= 1 && data.boardTitle.size() <= 100
        && data.role in ['editor', 'viewer']
        && data.addedAt is timestamp;
    }

    function isValidBoard(data) {
      return data.keys().hasAll(['ownerId', 'title', 'theme', 'windEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'theme', 'windEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.theme in ['light', 'candy', 'dark']
        && data.windEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardSecret(data) {
      return data.keys().hasAll(['wrappedKey', 'keyVersion', 'isPassphraseProtected', 'salt', 'keyCheck', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['wrappedKey', 'keyVersion', 'isPassphraseProtected', 'salt', 'keyCheck', 'createdAt', 'updatedAt'])
        && data.wrappedKey is string && data.wrappedKey.size() >= 16 && data.wrappedKey.size() <= 512
        && data.keyVersion is number && data.keyVersion >= 1 && data.keyVersion <= 1000
        && data.isPassphraseProtected is bool
        && data.salt is string && data.salt.size() <= 128
        && data.keyCheck is string && data.keyCheck.size() <= 512
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardMember(data, memberUid) {
      return data.keys().hasAll(['uid', 'boardOwnerId', 'email', 'displayName', 'photoURL', 'role', 'inviteId', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'boardOwnerId', 'email', 'displayName', 'photoURL', 'role', 'inviteId', 'joinedAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == memberUid
        && isValidId(data.boardOwnerId)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 1024
        && data.role in ['editor', 'viewer']
        && isValidId(data.inviteId)
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNoteItem(data) {
      return data.keys().hasAll([
          'type', 'color', 'font', 'fontSize', 'x', 'y', 'width', 'height',
          'tilt', 'zIndex', 'archived', 'encryptedPayload', 'iv',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'type', 'color', 'font', 'fontSize', 'x', 'y', 'width', 'height',
          'tilt', 'zIndex', 'archived', 'encryptedPayload', 'iv',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.type in ['sticky', 'checklist', 'pomodoro', 'habit', 'mood', 'clock']
        && data.color in ['butter', 'blush', 'mint', 'sky', 'lavender', 'peach']
        && data.font in ['sans', 'serif', 'mono', 'hand', 'display']
        && data.fontSize in ['sm', 'md', 'lg']
        && data.x is number && data.x >= -10000 && data.x <= 50000
        && data.y is number && data.y >= -10000 && data.y <= 50000
        && data.width is number && data.width >= 160 && data.width <= 1200
        && data.height is number && data.height >= 140 && data.height <= 1200
        && data.tilt is number && data.tilt >= -15 && data.tilt <= 15
        && data.zIndex is number && data.zIndex >= 0 && data.zIndex <= 1000000
        && data.archived is bool
        && data.encryptedPayload is string && data.encryptedPayload.size() >= 4 && data.encryptedPayload.size() <= 65536
        && data.iv is string && data.iv.size() >= 8 && data.iv.size() <= 64
        && isValidId(data.createdBy)
        && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBoardInvite(data) {
      return data.keys().hasAll([
          'boardId', 'boardTitle', 'ownerId', 'ownerName',
          'inviteeEmail', 'role', 'status', 'acceptedByUid',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'boardId', 'boardTitle', 'ownerId', 'ownerName',
          'inviteeEmail', 'role', 'status', 'acceptedByUid',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.boardId)
        && data.boardTitle is string && data.boardTitle.size() >= 1 && data.boardTitle.size() <= 100
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 120
        && data.inviteeEmail is string && data.inviteeEmail.size() >= 3 && data.inviteeEmail.size() <= 254
        && data.role in ['editor', 'viewer']
        && data.status in ['pending', 'accepted', 'revoked']
        && data.acceptedByUid is string && data.acceptedByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection: /users/{userId} (Strict PII Isolation)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if isEmailVerified() && isValidId(userId) && isOwner(userId);

      // Shared board pointers for collaborator quick discovery
      match /boardRefs/{boardId} {
        allow get: if isValidId(userId) && isValidId(boardId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isEmailVerified()
          && isValidId(userId)
          && isValidId(boardId)
          && isOwner(userId)
          && isValidBoardRef(incoming(), boardId)
          && incoming().addedAt == request.time
          && existsAfter(/databases/$(database)/documents/boards/$(boardId)/members/$(userId));
        allow update: if isEmailVerified()
          && isValidId(userId)
          && isValidId(boardId)
          && isOwner(userId)
          && isValidBoardRef(incoming(), boardId)
          && incoming().boardId == existing().boardId
          && incoming().ownerId == existing().ownerId
          && incoming().addedAt == existing().addedAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['boardTitle', 'role']);
        allow delete: if isEmailVerified() && isValidId(userId) && isValidId(boardId) && isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // Collection: /boards/{boardId}
    // -------------------------------------------------------------------------
    match /boards/{boardId} {
      allow get: if isValidId(boardId) && isBoardMember(boardId);
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(boardId)
        && isValidBoard(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(boardId)
        && isValidBoard(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'theme', 'windEnabled', 'updatedAt']);
      allow delete: if isEmailVerified()
        && isValidId(boardId)
        && existing().ownerId == request.auth.uid;

      // Subcollection: /boards/{boardId}/secrets/{secretId}
      match /secrets/{secretId} {
        allow get: if isValidId(boardId) && isValidId(secretId) && secretId == 'encryption' && isBoardMember(boardId);
        allow list: if false;
        allow create: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(secretId)
          && secretId == 'encryption'
          && isValidBoardSecret(incoming())
          && isBoardOwnerAfter(boardId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(secretId)
          && secretId == 'encryption'
          && isValidBoardSecret(incoming())
          && isBoardOwner(boardId)
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['wrappedKey', 'keyVersion', 'isPassphraseProtected', 'salt', 'keyCheck', 'updatedAt']);
        allow delete: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(secretId)
          && isBoardOwner(boardId);
      }

      // Subcollection: /boards/{boardId}/members/{memberUid}
      match /members/{memberUid} {
        allow get: if isValidId(boardId) && isValidId(memberUid) && (
          isBoardOwner(boardId) || (isSignedIn() && request.auth.uid == memberUid)
        );
        allow list: if isSignedIn() && (
          existing().boardOwnerId == request.auth.uid || existing().uid == request.auth.uid
        );
        allow create: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(memberUid)
          && isValidBoardMember(incoming(), memberUid)
          && boardExists(boardId)
          && incoming().boardOwnerId == getBoard(boardId).data.ownerId
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && (
            (
              memberUid == request.auth.uid
              && exists(/databases/$(database)/documents/invites/$(incoming().inviteId))
              && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.boardId == boardId
              && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.status == 'pending'
              && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.inviteeEmail == request.auth.token.email.lower()
              && get(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.role == incoming().role
              && getAfter(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/invites/$(incoming().inviteId)).data.acceptedByUid == request.auth.uid
            )
          );
        allow update: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(memberUid)
          && isValidBoardMember(incoming(), memberUid)
          && isBoardOwner(boardId)
          && incoming().uid == existing().uid
          && incoming().boardOwnerId == existing().boardOwnerId
          && incoming().inviteId == existing().inviteId
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);
        allow delete: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(memberUid)
          && (isBoardOwner(boardId) || request.auth.uid == memberUid);
      }

      // Subcollection: /boards/{boardId}/notes/{noteId}
      match /notes/{noteId} {
        allow get: if isValidId(boardId) && isValidId(noteId) && isBoardMember(boardId);
        allow list: if isSignedIn() && isBoardMember(boardId);
        allow create: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(noteId)
          && isValidNoteItem(incoming())
          && (canEditBoard(boardId) || isBoardOwnerAfter(boardId))
          && incoming().createdBy == request.auth.uid
          && incoming().updatedBy == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(noteId)
          && isValidNoteItem(incoming())
          && canEditBoard(boardId)
          && incoming().createdBy == existing().createdBy
          && incoming().createdAt == existing().createdAt
          && incoming().updatedBy == request.auth.uid
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'type', 'color', 'font', 'fontSize', 'x', 'y', 'width', 'height',
              'tilt', 'zIndex', 'archived', 'encryptedPayload', 'iv',
              'updatedBy', 'updatedAt'
            ])
          );
        allow delete: if isEmailVerified()
          && isValidId(boardId)
          && isValidId(noteId)
          && canEditBoard(boardId);
      }
    }

    // -------------------------------------------------------------------------
    // Collection: /invites/{inviteId}
    // -------------------------------------------------------------------------
    match /invites/{inviteId} {
      allow get: if isEmailVerified() && isValidId(inviteId) && (
        existing().ownerId == request.auth.uid ||
        existing().inviteeEmail == request.auth.token.email.lower()
      );
      allow list: if isEmailVerified() && (
        existing().ownerId == request.auth.uid ||
        existing().inviteeEmail == request.auth.token.email.lower()
      );
      allow create: if isEmailVerified()
        && isValidId(inviteId)
        && isValidBoardInvite(incoming())
        && isBoardOwner(incoming().boardId)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().acceptedByUid == ''
        && incoming().inviteeEmail == incoming().inviteeEmail.lower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isValidId(inviteId)
        && isValidBoardInvite(incoming())
        && incoming().boardId == existing().boardId
        && incoming().ownerId == existing().ownerId
        && incoming().inviteeEmail == existing().inviteeEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates role or revokes pending invite
          (
            existing().ownerId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status in ['pending', 'revoked']
            && incoming().acceptedByUid == existing().acceptedByUid
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'boardTitle', 'updatedAt'])
          )
          ||
          // Action 2: Invitee accepts pending invite atomically with member doc creation
          (
            existing().inviteeEmail == request.auth.token.email.lower()
            && existing().status == 'pending'
            && incoming().status == 'accepted'
            && incoming().acceptedByUid == request.auth.uid
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/boards/$(existing().boardId)/members/$(request.auth.uid))
          )
        );
      allow delete: if isEmailVerified()
        && isValidId(inviteId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
